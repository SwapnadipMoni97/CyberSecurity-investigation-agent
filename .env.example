# Optional. Leave blank to use the local deterministic report generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Local persistence. The database is created automatically.
SECOPS_DATABASE_PATH=./data/secops.db

# Keep false unless you intentionally want investigations sent to a hosted model.
USE_HOSTED_MODEL=false

# Optional LangSmith tracing for LangGraph runs.
# Traces can contain investigation questions and event evidence. Use synthetic or sanitized data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secops-investigation-agent
